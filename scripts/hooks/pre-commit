#!/bin/sh

set -eu

branch="$(git branch --show-current)"
allowance="$(git config --bool deeptutor.allowMainCommit || true)"
if [ "$branch" = "main" ] && [ "$allowance" != "true" ]; then
  echo "Direct commits to main are forbidden. Develop on dev or a topic branch, then integrate through review. For an explicit release exception, set deeptutor.allowMainCommit=true and unset it afterward." >&2
  exit 1
fi
