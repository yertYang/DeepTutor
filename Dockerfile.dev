# A development toolchain only. Source and Linux build caches are mounted by Compose.
FROM rust:1.89.0-slim-bookworm AS rust-toolchain
FROM node:22.23.4-bookworm-slim
COPY --from=rust-toolchain /usr/local/cargo /usr/local/cargo
COPY --from=rust-toolchain /usr/local/rustup /usr/local/rustup
ENV PATH=/usr/local/cargo/bin:$PATH \
    RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config ca-certificates git \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
CMD ["bash", "scripts/docker-dev.sh"]
