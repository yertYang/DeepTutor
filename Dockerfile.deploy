FROM node:22.23.4-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS frontend-builder
WORKDIR /app/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --legacy-peer-deps
COPY web/ ./
COPY deeptutor/__version__.py /app/deeptutor/__version__.py
RUN npx vitest run tests/inline-file-artifact-shapes.spec.ts tests/provider-registry-workflow.spec.tsx tests/voice-settings.spec.tsx tests/task-models-workflow.spec.tsx tests/reasoning-effort-selector.spec.tsx
RUN npm run build

FROM ghcr.io/hkuds/deeptutor:1.7.1@sha256:4982ca6bf43b98431366b43d1fec674a63656db3fbe49ba18c674bb6f19196dd
USER root
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir "edge-tts>=7.0,<8.0"
RUN rm -rf /app/web
COPY --from=frontend-builder --chown=deeptutor:deeptutor /app/web/.next/standalone /app/web
COPY deeptutor/ /app/deeptutor/
COPY deeptutor_cli/ /app/deeptutor_cli/
COPY scripts/ /app/scripts/
COPY pyproject.toml build_metadata.py requirements.txt /app/
COPY requirements/ /app/requirements/
ARG VCS_REF=unknown
LABEL org.opencontainers.image.source="https://github.com/yertYang/DeepTutor" \
      org.opencontainers.image.revision="${VCS_REF}" \
      cc.zorvya.deeptutor.hotfix="1.7.1-fork-deploy"
